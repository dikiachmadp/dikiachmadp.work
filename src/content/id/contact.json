{
  "form": {
    "id": "main-contact-form",
    "fields": [
      {
        "id": "field-name",
        "name": "name",
        "type": "text",
        "label": "Nama",
        "placeholder": "Nama Anda",
        "required": true
      },
      {
        "id": "field-email",
        "name": "email",
        "type": "email",
        "label": "Email",
        "placeholder": "halo@contoh.com",
        "required": true
      },
      {
        "id": "field-inquiry",
        "name": "inquiryType",
        "type": "select",
        "label": "Apa yang sedang Anda cari?",
        "placeholder": "Pilih opsi",
        "options": [
          {
            "value": "web-development",
            "label": "Pengembangan Web"
          },
          {
            "value": "brand-identity",
            "label": "Identitas Merek"
          },
          {
            "value": "3d-design",
            "label": "Desain 3D"
          },
          {
            "value": "ui-ux-design",
            "label": "Desain UI/UX"
          },
          {
            "value": "other",
            "label": "Lainnya"
          }
        ],
        "required": true
      },
      {
        "id": "field-message",
        "name": "message",
        "type": "textarea",
        "label": "Pesan",
        "placeholder": "Ceritakan tentang proyek Anda...",
        "required": true
      }
    ],
    "submitAction": {
      "uiKey": "submit"
    }
  }
}
# Copy to .env and fill in the real values. Never commit .env itself.
# Every variable below must also be set in the hosting provider
# (Vercel > Project > Settings > Environment Variables).

# --- Database -----------------------------------------------------------
# Supabase Postgres, Session pooler (port 5432).
# Dashboard > Settings > Database > Connection string.
# Used by: src/lib/prisma.ts (admin dashboard CRUD).
DATABASE_URL=

# --- Auth ---------------------------------------------------------------
# Supabase project URL and anon key.
# Dashboard > Settings > API.
# Used by: src/proxy.ts, src/lib/supabase/*. Without these the middleware
# fails closed and /dashboard becomes unreachable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated list of emails allowed into the dashboard. Required.
# The anon key ships to the browser, so a Supabase session proves identity but
# not authority — this list is what makes an account an admin.
# Used by: src/lib/admin-allowlist.ts (via src/lib/env.ts and src/proxy.ts).
ADMIN_EMAILS=

# Canonical origin, no trailing slash (e.g. https://dikiachmadp.work).
# Used by: src/lib/site-url.ts to build Supabase password-reset links. Optional
# — falls back to the production domain on Vercel and to localhost in dev — but
# set it explicitly in production so the link never depends on a guess.
SITE_URL=

# --- Contact form -------------------------------------------------------
# Used by: src/app/api/contact/route.ts. The route returns a 500
# "Server configuration error" unless RESEND_API_KEY, CONTACT_EMAIL and
# both UPSTASH_* values are present.
RESEND_API_KEY=
CONTACT_EMAIL=

# Rate limiting for the contact form (Upstash Redis REST credentials).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Falls back to "Portfolio Contact Form <onboarding@resend.dev>".
RESEND_FROM_EMAIL=

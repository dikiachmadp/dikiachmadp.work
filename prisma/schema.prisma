// Schema database. Konten yang berbeda antar bahasa hidup di
// ProjectTranslation; field yang sama untuk semua bahasa hidup di Project.

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id            String   @id @default(uuid())
  slug          String   @unique
  // Identitas kategori. Satu-satunya sumbernya; labelnya per bahasa hidup di
  // src/content/{en,id}/projects.json dan dicari lewat kunci ini saat render.
  categoryKey   String
  year          String
  date          String
  coverImage    String
  logoUrl       String?
  featured      Boolean  @default(false)
  liveUrl       String?
  isLivePreview Boolean  @default(false)
  tags          String[]
  tools         String[]
  gallery       String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  translations ProjectTranslation[]

  @@index([featured])
}

model ProjectTranslation {
  id            String @id @default(uuid())
  projectId     String
  locale        String
  title         String
  client        String
  description   String
  role          String?
  duration      String?
  contentBlocks Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
  @@index([locale])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

// Logbook. Berbeda dari Project: tidak ada kolom cover terpisah (cover adalah
// gambar galeri dengan `order` terkecil), tidak ada tag, dan tanggalnya bertipe
// tanggal. Gambar melekat pada translation karena `alt` wajib diterjemahkan.
model LogbookPost {
  id          String     @id @default(uuid())
  status      PostStatus @default(DRAFT)
  // null selama draft; terisi saat pos pertama kali diterbitkan.
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  translations LogbookPostTranslation[]

  @@index([status, publishedAt(sort: Desc)])
}

model LogbookPostTranslation {
  id      String @id @default(uuid())
  postId  String
  locale  String
  slug    String
  title   String
  excerpt String
  // Markdown GFM, bukan JSON longgar.
  body    String

  post   LogbookPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  images LogbookImage[]

  @@unique([postId, locale])
  // Slug unik per bahasa, bukan global — pos ID dan EN boleh berbagi slug.
  @@unique([locale, slug])
  @@index([locale, postId])
}

model LogbookImage {
  id            String  @id @default(uuid())
  translationId String
  url           String
  // Wajib: tanpa ini galeri tidak bisa diakses.
  alt           String
  caption       String?
  order         Int     @default(0)

  translation LogbookPostTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@index([translationId, order])
}

model Testimonial {
  id         String   @id @default(uuid())
  locale     String   @default("en")
  name       String
  role       String
  content    String
  avatarUrl  String?
  projectRef String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([locale, order])
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

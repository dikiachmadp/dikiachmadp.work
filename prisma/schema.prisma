// Schema database. Konten yang berbeda antar bahasa hidup di
// ProjectTranslation; field yang sama untuk semua bahasa hidup di Project.

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id            String   @id @default(uuid())
  slug          String   @unique
  // Identitas kategori. Satu-satunya sumbernya; labelnya per bahasa hidup di
  // src/content/{en,id}/projects.json dan dicari lewat kunci ini saat render.
  categoryKey   String
  year          String
  date          String
  coverImage    String
  logoUrl       String?
  featured      Boolean  @default(false)
  liveUrl       String?
  isLivePreview Boolean  @default(false)
  tags          String[]
  tools         String[]
  gallery       String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  translations ProjectTranslation[]

  @@index([featured])
}

model ProjectTranslation {
  id            String @id @default(uuid())
  projectId     String
  locale        String
  title         String
  client        String
  description   String
  role          String?
  duration      String?
  contentBlocks Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
  @@index([locale])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

// Logbook. Berbeda dari Project: tidak ada kolom cover terpisah (cover adalah
// gambar galeri dengan `order` terkecil), tidak ada tag, dan tanggalnya bertipe
// tanggal. Gambar melekat pada translation karena `alt` wajib diterjemahkan.
model LogbookPost {
  id          String     @id @default(uuid())
  status      PostStatus @default(DRAFT)
  // null selama draft; terisi saat pos pertama kali diterbitkan.
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  translations LogbookPostTranslation[]

  @@index([status, publishedAt(sort: Desc)])
}

model LogbookPostTranslation {
  id      String @id @default(uuid())
  postId  String
  locale  String
  slug    String
  title   String
  excerpt String
  // Markdown GFM, bukan JSON longgar.
  body    String

  post   LogbookPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  images LogbookImage[]

  @@unique([postId, locale])
  // Slug unik per bahasa, bukan global — pos ID dan EN boleh berbagi slug.
  @@unique([locale, slug])
  @@index([locale, postId])
}

model LogbookImage {
  id            String  @id @default(uuid())
  translationId String
  url           String
  // Wajib: tanpa ini galeri tidak bisa diakses.
  alt           String
  caption       String?
  order         Int     @default(0)

  translation LogbookPostTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@index([translationId, order])
}

model Testimonial {
  id         String   @id @default(uuid())
  locale     String   @default("en")
  name       String
  role       String
  content    String
  avatarUrl  String?
  projectRef String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([locale, order])
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum AboutEntryKind {
  EXPERIENCE
  CERTIFICATION
}

// Halaman About. Satu baris saja: bukan daftar seperti Project atau
// LogbookPost, jadi tidak ada slug atau status draft — hanya profil yang
// selalu tayang dan diedit di tempat lewat admin.
model AboutProfile {
  id          String   @id @default(uuid())
  portraitUrl String?
  updatedAt   DateTime @updatedAt

  translations AboutProfileTranslation[]
}

model AboutProfileTranslation {
  id                  String @id @default(uuid())
  profileId           String
  locale              String
  // Satu entri per paragraf, seperti pola array String[] lain di schema ini.
  biography           String[]
  sticker             String
  experienceTitle     String
  skillsTitle         String
  certificationsTitle String
  cvNote              String
  // Bentuknya stabil dan selalu diedit sekaligus lewat satu form, jadi tidak
  // layak jadi tabel tersendiri — sama seperti Project.contentBlocks.
  // skills:  { category: string, items: string[] }[]
  // cvItems: { label: string, href: string }[]
  skills              Json
  cvItems             Json

  profile AboutProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, locale])
}

// Pengalaman kerja dan sertifikasi. Baris per bahasa seperti Testimonial,
// bukan tabel terjemahan — daftarnya boleh tidak sinkron antar bahasa, dan
// menambah satu entri tidak pernah menuntut entri pasangannya di bahasa lain.
model AboutEntry {
  id       String         @id @default(uuid())
  kind     AboutEntryKind
  locale   String
  order    Int            @default(0)
  year     String
  // Peran (EXPERIENCE) atau nama sertifikasi (CERTIFICATION).
  title    String
  // Tempat kerja (EXPERIENCE) atau penerbit (CERTIFICATION).
  subtitle String
  // Tautan verifikasi sertifikat; tidak berlaku untuk EXPERIENCE.
  url      String?

  @@index([kind, locale, order])
}

// Digital products. Cermin Project (gambar melekat di induk, bukan di
// translation — tidak butuh `alt` per bahasa), tapi berdraf seperti
// LogbookPost karena produk yang belum siap dijual tidak boleh terindeks.
model DigitalProduct {
  id          String     @id @default(uuid())
  status      PostStatus @default(DRAFT)
  // null selama draft; terisi saat produk pertama kali diterbitkan.
  publishedAt DateTime?
  featured    Boolean    @default(false)
  order       Int        @default(0)
  // Decimal, bukan Float — harga tidak boleh kena galat pembulatan biner.
  price       Decimal?   @db.Decimal(10, 2)
  currency    String     @default("USD")
  // Tautan toko eksternal (Gumroad dsb). Opsional sejak checkout on-site ada:
  // produk yang dijual lewat Polar tidak punya URL luar sama sekali.
  buyUrl      String?
  // ID produk di Polar. Terisi -> tombol beli membuka checkout di halaman ini.
  // Kosong -> jatuh balik ke `buyUrl`, perilaku sebelum fitur ini ada.
  polarProductId String?
  // Menyalakan panel "bayar sesukanya". Produknya sendiri harus dikonfigurasi
  // Pay What You Want di Polar; menyalakan ini tanpa itu membuat Polar menolak
  // `amount` yang dikirim.
  pwywEnabled   Boolean  @default(false)
  // Sen USD. Batas bawah yang ditawarkan UI — Polar tetap penentu akhirnya.
  pwywMinAmount Int      @default(0)
  coverImage  String
  gallery     String[]
  tags        String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  translations DigitalProductTranslation[]
  orders       Order[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([order])
}

model DigitalProductTranslation {
  id        String @id @default(uuid())
  productId String
  locale    String
  slug      String
  title     String
  summary   String
  // Markdown GFM, sama seperti LogbookPostTranslation.body.
  body      String

  product DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  // Slug unik per bahasa, bukan global — sama seperti Logbook.
  @@unique([locale, slug])
  @@index([locale, productId])
}

// Checkout yang benar-benar selesai dibayar, direkam dari webhook `order.paid`
// Polar. Bukan salinan dasbor Polar: `polarOrderId` yang unik itulah kunci
// idempotensinya — webhook boleh datang dua kali, dan barisnya tetap satu.
model Order {
  id              String   @id @default(uuid())
  polarOrderId    String   @unique
  polarCheckoutId String?
  // SetNull, bukan Cascade: menghapus produk tidak boleh menghapus riwayat
  // transaksinya.
  productId       String?
  email           String
  // Sen. Nol untuk produk gratis yang diambil tanpa tip.
  amount          Int
  currency        String   @default("USD")
  createdAt       DateTime @default(now())

  product DigitalProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([productId])
}
